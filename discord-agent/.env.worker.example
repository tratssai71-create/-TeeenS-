# ロールごとにコピーして .env.designer などを作る(AGENT_NAME は省略するとロール名になる)
AGENT_NAME=designer
DISCORD_TOKEN=ここにBotトークン
# このエージェントに直接指示する専用チャンネルID(カンマ区切り)。司令塔経由だけなら空のままにする
# ※ #command は指定しない(司令塔と二重に反応してしまう)
CHANNEL_IDS=
# 指示を出してよいユーザーID(あなたのID。カンマ区切り)
ALLOWED_USER_IDS=123456789012345678
# Codexが作業するディレクトリ
WORKDIR=/path/to/work
# codex exec に渡す追加引数(スペース区切り)。権限は最小限に
CODEX_ARGS=--sandbox workspace-write --skip-git-repo-check
# 1タスクの最大時間(分)
TIMEOUT_MIN=30

# --- ワーカーモード(司令塔と連携するとき) ---
# TASKS_CHANNEL_ID=タスクJSONが流れるチャンネルID
# LOG_CHANNEL_ID=進捗ログのチャンネルID
# ORCHESTRATOR_BOT_ID=司令塔BotのユーザーID(このBotの発言だけ信頼する)
# --- publisherワーカー専用 ---
# REQUIRE_APPROVAL=1
# APPROVAL_SECRET=司令塔と同じ値
