# 司令塔Bot用(1台だけで動かす)。ワーカーとは別のBotトークンを使う
DISCORD_TOKEN=司令塔Botのトークン
COMMAND_CHANNEL_ID=依頼を書くチャンネルID
TASKS_CHANNEL_ID=タスクJSONのチャンネルID(Botのみ書き込み可に設定)
LOG_CHANNEL_ID=進捗ログのチャンネルID
ALLOWED_USER_IDS=あなたのユーザーID
# 結果を受け付けるワーカーBotのユーザーID(カンマ区切り)
WORKER_BOT_IDS=
ROLES=designer,writer,qa
WORKDIR=/path/to/work
MAX_TASKS=8
MAX_RETRY=2
TASK_TIMEOUT_MIN=30
MAX_JOBS_PER_DAY=20

# --- 公開承認(P4) ---
APPROVE_CHANNEL_ID=承認ボタンを出すチャンネルID
# 公開承認トークンの署名鍵。publisherワーカーと同じ値にする(ランダムな長い文字列。コミット禁止)
APPROVAL_SECRET=
PUBLISHER_ROLE=publisher
# PUBLISH_INSTRUCTIONS=(任意)公開手順の指示を上書き
